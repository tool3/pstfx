{
  "name": "vctrfx",
  "version": "0.9.0",
  "description": "Post-processing effects for any SVG. Scanlines, bloom, glitch, halftone and more \u2014 in, out, still an SVG.",
  "keywords": [
    "svg",
    "postprocessing",
    "post-processing",
    "effects",
    "filter",
    "glitch",
    "scanlines",
    "bloom",
    "halftone",
    "duotone",
    "design"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tool3/vctrfx.git"
  },
  "bugs": {
    "url": "https://github.com/tool3/vctrfx/issues"
  },
  "homepage": "https://github.com/tool3/vctrfx#readme",
  "author": "Tal Hayut",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json && cp dist/index.d.ts dist/index.d.cts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "examples": "node examples/run-all.ts",
    "gallery": "node scripts/gallery.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "shellfie": "^2.4.4",
    "typescript": "^7.0.2",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "grfti": "^0.5.0"
  }
}
